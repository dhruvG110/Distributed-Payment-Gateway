// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ledger_transaction {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id     String         @unique @db.Uuid
  reference      String         @unique @db.VarChar(100)
  amount         BigInt
  currency       String         @default("INR") @db.VarChar(3)
  status         ledger_status  @default(posted)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)

  entries        ledger_entry[]

  @@index([created_at])
}

model ledger_entry {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id String              @db.Uuid
  wallet_id      String              @db.Uuid
  entry_type     entry_type
  amount         BigInt
  currency       String              @default("INR") @db.VarChar(3)
  created_at     DateTime            @default(now()) @db.Timestamptz(6)

  transaction   ledger_transaction @relation(fields: [transaction_id], references: [id])

  @@index([wallet_id, created_at])
  @@index([transaction_id])
}
model wallet_operation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_id   String   @db.Uuid
  payment_id  String   @unique @db.Uuid
  operation   String   @db.VarChar(20)
  amount      BigInt
  status      String   @default("reserved") @db.VarChar(20)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([wallet_id, created_at])
  @@index([status])
}
enum entry_type {
  debit
  credit
}

enum ledger_status {
  posted
  reversed
}
