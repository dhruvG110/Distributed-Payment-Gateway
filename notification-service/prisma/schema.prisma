generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model notification {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_user_id  String              @db.Uuid
  event_id           String              @db.Uuid
  payment_id         String              @db.Uuid
  type               notification_type
  title              String              @db.VarChar(120)
  message            String              @db.VarChar(500)
  data               Json?
  is_read            Boolean             @default(false)
  read_at            DateTime?           @db.Timestamptz(6)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)

  // Event identity makes HTTP retries idempotent per recipient and notification type.
  @@unique([recipient_user_id, event_id, type])
  @@index([recipient_user_id, created_at])
  @@index([recipient_user_id, is_read])
}

enum notification_type {
  payment_success
  payment_failed
  money_received
}
